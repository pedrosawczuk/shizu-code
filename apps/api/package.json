{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node24 --sourcemap --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@app/env": "workspace:*",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
