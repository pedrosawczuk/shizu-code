{
	"name": "@app/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts"
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:sync": "pnpm db:generate && pnpm db:migrate",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@app/env": "workspace:*",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@app/tsconfig": "workspace:*",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
